generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model WhitelistSession {
  id          Int      @id @default(autoincrement())
  userId      String   // The user being whitelisted
  staffId     String   // The staff member conducting the whitelist
  status      String   @default("PENDING") // PENDING, APPROVED, DENIED
  startTime   DateTime @default(now())
  endTime     DateTime?
  channelId   String
  messageId   String?
  notes       String?
}
